{
  "name": "@superq/search-before-build",
  "version": "0.3.1",
  "description": "Install the Search Before Build Codex plugin from its official marketplace.",
  "license": "MIT",
  "type": "module",
  "author": "superq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/user-w-ui/search-before-build.git"
  },
  "bugs": {
    "url": "https://github.com/user-w-ui/search-before-build/issues"
  },
  "homepage": "https://github.com/user-w-ui/search-before-build#readme",
  "keywords": [
    "codex",
    "codex-plugin",
    "plugin",
    "claude code",
    "agent-skill",
    "vibe-coding"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "bin": {
    "search-before-build": "bin/install.mjs"
  },
  "files": [
    "bin/",
    "index.js",
    "skills/",
    "references/",
    "dist/",
    "scripts/render-report.mjs",
    "scripts/setup-github-mcp.mjs",
    "assets/report-viewer.html",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/kernel/normalize.test.mjs tests/kernel/pipeline.test.mjs tests/kernel/cli.test.mjs tests/hosts/opencode-plugin.test.mjs && node --check bin/install.mjs",
    "benchmark:offline": "npm run build && node bench/run-offline.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
